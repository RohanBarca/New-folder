# Comma-separated frontend origins, including the production Netlify URL.
FRONTEND_ORIGINS=https://your-site.netlify.app

# MedSync Backend — Environment Variables Template
# Copy this file to backend/.env and fill in your values.
# NEVER commit backend/.env to version control.

# ── OCR.space ───────────────────────────────────────────────────────────────
OCR_SPACE_API_KEY=

# ── Groq AI (LLaMA) ─────────────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── Database ─────────────────────────────────────────────────────────────────
# Supabase PostgreSQL connection string (use the Connection Pooler URL for IPv4)
DATABASE_URL=postgresql://...

# ── JWT / Session Security ────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── MSG91 OTP (Real SMS) ─────────────────────────────────────────────────────
# 1. Create an account at https://control.msg91.com/
# 2. Get your authkey from Settings > AuthKey
# 3. Create an OTP Widget: OTP section > Widget > Create Widget
# 4. Copy the Widget ID below
MSG91_AUTHKEY=
MSG91_WIDGET_ID=
MSG91_TOKEN_AUTH=

# OTP behavior
OTP_PROVIDER=msg91
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30

# Sarvam Speech-to-Text (backend only)
ASR_PROVIDER=sarvam
SARVAM_API_KEY=
ASR_MAX_AUDIO_SIZE_MB=25
ASR_TIMEOUT_SECONDS=30

# ── Voice (optional) ─────────────────────────────────────────────────────────
ASR_PROVIDER=not_configured
TTS_PROVIDER=not_configured
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_PIPELINE_ID=

# ── ABDM (optional, demo mode only) ─────────────────────────────────────────
ABDM_ENABLED=false
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
ABDM_BASE_URL=https://dev.abdm.gov.in/gateway/v0.5

# ── Misc ─────────────────────────────────────────────────────────────────────
SESSION_TIMEOUT_MINUTES=60
DATA_RETENTION_DAYS=365
